# Copy to .env.local for local development. Never commit .env.local.
# Every value below is a placeholder that lets `pnpm build`, `pnpm typecheck`,
# `pnpm lint` and `pnpm test` pass without real credentials.

# --- Clerk (https://dashboard.clerk.com > API keys) -------------------------
# The publishable key must be syntactically valid: "pk_test_" + base64 of
# "<frontend-api-host>$". The placeholder decodes to "clerk.example.com$".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=sk_test_placeholder
# Clerk dashboard > Webhooks > your endpoint (<origin>/api/webhooks/clerk) > Signing secret
CLERK_WEBHOOK_SECRET=whsec_placeholder
# Where Clerk sends people to sign in and where they land afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/canvases
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/canvases

# --- Database (Supabase Postgres, or any Postgres) ---------------------------
# Supabase: Project settings > Database > Connection string (URI). Use the
# transaction pooler (port 6543) on Vercel, the direct connection for migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/craftcanvas

# --- Craft key encryption ----------------------------------------------------
# Random secret used to derive the AES-256-GCM key for Craft API keys at rest.
# Generate a real one with: openssl rand -base64 32
CRAFT_KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-secret

# --- Supabase Storage (optional, canvas thumbnails) --------------------------
# Leave blank to store thumbnails as data URLs in the database instead.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
SUPABASE_THUMBNAIL_BUCKET=thumbnails
