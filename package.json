{
  "name": "craftcanvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply craftcanvas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply craftcanvas-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.157.0"
  }
}
