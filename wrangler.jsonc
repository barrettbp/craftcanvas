{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "craftcanvas",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // The Worker sees every request so the auth gate covers the SPA shell and its assets too.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "craftcanvas-db",
      // Replaced by `wrangler d1 create craftcanvas-db` at deploy time. Local dev and tests ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "fixture" serves bundled sample notes; "craft" reads from the Craft API (needs CRAFT_CONNECTION_URL secret).
    // Secrets (never here): APP_PASSWORD, SESSION_SECRET, CRAFT_CONNECTION_URL, optional CRAFT_API_TOKEN.
    "CRAFT_MODE": "auto"
  }
}
